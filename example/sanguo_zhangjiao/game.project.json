  "dialogues": [
    {
      "id": "dialogue.s02.zhangjiaoSummons",
      "title": "张角召见",
      "startNode": "start",
      "nodes": {
        "start": {
          "speaker": "黄巾信使",
          "text": "你终于到了。张角正在粥棚营地召集仍愿救民的人。",
          "nextNode": "accept"
        },
        "accept": {
          "speaker": "你",
          "text": "我会前去赴约。先把这里能用的物资收拾妥当。"
        }
      }
    },
    {
      "id": "dialogue.s09.enlistment",
      "title": "加入黄巾",
      "startNode": "start",
      "nodes": {
        "start": {
          "speaker": "张角",
          "text": "苍生困于饥疫，空有一人之勇救不了天下。你可愿留下，与我们一道护送粮药、救济流民？",
          "nextNode": "answer"
        },
        "answer": {
          "speaker": "你",
          "text": "我愿加入黄巾，但愿手中所学真能让百姓活下去。",
          "nextNode": "choose"
        },
        "choose": {
          "speaker": "张角",
          "text": "去看三面军旗。张梁授战士之法，张宝授弓手之法；若愿研习符法军略，便来承军师之责。职业一旦确认，不可更改。"
        }
      }
    },
    {
      "id": "dialogue.s09.refugeeConflict",
      "title": "饥民争斗",
      "startNode": "start",
      "nodes": {
        "start": {
          "speaker": "断臂饥民",
          "text": "残兵护着最后几块饼，妇人抱紧孩子，地上两个人已经没了声息。断臂汉子把半块饼攥得发白。",
          "nextNode": "donationOffer"
        },
        "donationOffer": {
          "speaker": "断臂饥民",
          "text": "再没有粮，今晚就会有人为这一口吃的拼命。你若拿得出二十份粮食，至少能让大家先停手。",
          "choices": [
            {
              "id": "donate_food",
              "text": "捐出粮食 ×20",
              "nextNode": "donationProcessing"
            },
            {
              "id": "defer",
              "text": "我还需要准备",
              "nextNode": "deferred"
            }
          ]
        },
        "donationProcessing": {
          "speaker": "你",
          "text": "先清点粮食，任何一项无法落实都不能让现场留下半笔账。",
          "nextNode": "donationProcessing"
        },
        "donationFailed": {
          "speaker": "断臂饥民",
          "text": "粮食还不够，或检查点没能安全写入。刚才的粮食、士气和城市状态都没有改变。",
          "choices": [
            {
              "id": "retry_donation",
              "text": "再次尝试捐出粮食 ×20",
              "nextNode": "donationProcessing"
            },
            {
              "id": "defer",
              "text": "稍后再来",
              "nextNode": "deferred"
            }
          ]
        },
        "deferred": {
          "speaker": "你",
          "text": "我先去准备粮食。现场仍会保留，之后可以回来继续处理。"
        },
        "branchChoice": {
          "speaker": "断臂饥民",
          "text": "众人暂时停手，却都等着你决定接下来怎么办。这个选择无法撤回。",
          "choices": [
            {
              "id": "hardline",
              "text": "强硬：命残兵控制人群",
              "nextNode": "branchProcessing"
            },
            {
              "id": "appease",
              "text": "安抚采集：带人寻找燃料与散粮",
              "nextNode": "branchProcessing"
            },
            {
              "id": "silence",
              "text": "沉默：不再介入",
              "nextNode": "branchProcessing"
            }
          ]
        },
        "branchProcessing": {
          "speaker": "你",
          "text": "决定正在写入检查点……",
          "nextNode": "branchProcessing"
        },
        "hardlineResult": {
          "speaker": "黄巾残兵",
          "text": "残兵列成一线压住人群。争斗停了，但所有人都记住了这份强硬。"
        },
        "appeaseSuccessResult": {
          "speaker": "妇人",
          "text": "斧头还能用。众人带回燃料和散粮，营地粮食增加了三十份。"
        },
        "appeaseScoutResult": {
          "speaker": "黄巾残兵",
          "text": "没有可用的斧头，队伍在荒地拖延太久，官军斥候已经循声赶来！"
        },
        "silenceResult": {
          "speaker": "断臂饥民",
          "text": "你没有回答。汉子把饼藏回怀里；到下一游戏日，沉默的代价才会显现。"
        }
      }
    }
  ],
